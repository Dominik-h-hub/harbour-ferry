[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-ferry
Exec=sailfish-qml harbour-ferry
Name=FerrySync

[X-Sailjail]
# Sandboxing disabled: inside the jail the Sailfish Secrets daemon
# socket is invisible, system binaries (systemctl, python3) cannot be
# executed and the systemd D-Bus API is unreachable - background sync and
# secrets storage are impossible sandboxed. rclone, network and config
# encryption did work sandboxed.
Sandboxing=Disabled
OrganizationName=harbour-ferry
ApplicationName=harbour-ferry

[X-HarbourBackup]
# Only what is still useful after a restore. Left out on purpose:
# rclone.conf (encrypted, its password lives in Sailfish Secrets and is not
# part of the backup), config-pass (plain-text fallback password), bisync/
# (stale prior listings would turn missing local files into remote deletes;
# without them the next run resyncs) and logs, caches, filters and locks.
BackupPathList=.config/harbour-ferry/harbour-ferry/settings.json:.config/harbour-ferry/harbour-ferry/known_hosts:.local/share/harbour-ferry/harbour-ferry/sync-pairs.json:.local/share/harbour-ferry/harbour-ferry/encrypted-libraries.json
